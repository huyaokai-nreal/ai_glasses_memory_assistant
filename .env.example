# Copy this file to "$AI_GLASSES_HOME/.env" and fill local secrets there.
# Do not commit real API keys, tokens, local paths, certificates, or user data.

AI_GLASSES_HOME=

# Default LLM provider for new development.
AI_GLASSES_LLM_PROVIDER=deepseek
AI_GLASSES_LLM_MODEL=deepseek-v4-flash
AI_GLASSES_LLM_BASE_URL=https://api.deepseek.com
AI_GLASSES_LLM_API_KEY=
AI_GLASSES_LLM_API_MODE=chat_completions

# Optional local audio models. Leave empty unless you are working on voice features.
AI_GLASSES_ASR_MODEL_DIR=
AI_GLASSES_STREAMING_ASR_MODEL_DIR=
AI_GLASSES_SPEAKER_MODEL_DIR=
AI_GLASSES_EMOTION_MODEL_DIR=
AI_GLASSES_KWS_MODEL_DIR=
AI_GLASSES_KWS_KEYWORDS_FILE=
AI_GLASSES_WAKE_ACK_TEXT=我在

# Derived discussion archive. Raw redacted ambient transcripts expire; summaries persist until deleted.
AI_GLASSES_DISCUSSION_RAW_RETENTION_DAYS=30
AI_GLASSES_DISCUSSION_IDLE_GAP_SECONDS=180
AI_GLASSES_DISCUSSION_MAX_SLICE_SECONDS=900
AI_GLASSES_DISCUSSION_MAX_SLICE_SEGMENTS=40
AI_GLASSES_DISCUSSION_QUERY_WAIT_SECONDS=15
AI_GLASSES_DISCUSSION_PURGE_BATCH_SIZE=500
AI_GLASSES_DISCUSSION_RECOVERY_BATCH_SIZE=500
