# Tolaria app files (machine-specific, never commit)
.laputa/settings.json

# Local secrets and runtime configuration
.env
.env.*
!.env.example

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python runtime artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Local HTTPS test certificates
certs/

# Local agent/task scratch spaces
.planning/
.superpowers/
.external/

# WorkBuddy local project memory (session logs, never commit)
.workbuddy/memory/

# Thumbnails
._*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Xcode per-user state (UI layout, personal scheme settings)
xcuserdata/
*.xcuserstate

# Android local toolchain and build outputs
android/.gradle/
android/.kotlin/
android/local.properties
android/**/build/
android/.deps/
android/captures/
captures/
ios/.deps/
ios/.local-models/

# Local benchmark datasets
data
# V2 Eval_Ali only versions its compact TextGrid-derived rubric; raw data stays local.
!data/
data/*
!data/benchmarks/
data/benchmarks/*
!data/benchmarks/eval_ali/
data/benchmarks/eval_ali/*
!data/benchmarks/eval_ali/ambient_memory_v2_gold.json

# Local Eval_Ali offline streaming reports and isolated app state
reports/eval_ali/
